-- Resolve the current game's display name (e.g. "Baseplate") so every game
-- automatically gets its own config folder under Bishop, without having
-- to hardcode/rename Config per script.
--
-- Uses an ALLOWLIST (keep only letters/digits/space/hyphen/underscore) rather
-- than a blocklist, since game titles can contain emoji, unicode, or other
-- characters that are perfectly valid in a Roblox title but illegal (or
-- rejected by the executor's own path parser) in a real Windows folder name.
local BISHOP_DIRECTORY = "Bishop"

local function sanitizeFolderName(name)
    name = name:gsub("[^%w%s%-]", "_")   -- anything not alnum/space/hyphen -> "_"
    name = name:gsub("%s+", " ")          -- collapse whitespace runs
    name = name:match("^%s*(.-)%s*$")     -- trim leading/trailing space
    name = name:gsub("%.+$", "")          -- Windows disallows trailing dots
    name = name:match("^%s*(.-)%s*$")     -- trim again in case a dot exposed trailing space

    if name == "" then return nil end

    -- Windows reserved device names can't be used as folder names either
    local reserved = {
        CON = true, PRN = true, AUX = true, NUL = true,
        COM1 = true, COM2 = true, COM3 = true, COM4 = true, COM5 = true,
        COM6 = true, COM7 = true, COM8 = true, COM9 = true,
        LPT1 = true, LPT2 = true, LPT3 = true, LPT4 = true, LPT5 = true,
        LPT6 = true, LPT7 = true, LPT8 = true, LPT9 = true,
    }
    if reserved[name:upper()] then
        name = name .. "_Game"
    end

    return name
end

-- Roblox lets a game's store title change at any time, but game.PlaceId never
-- does. If we keyed the config folder purely off the display name, a title
-- change would silently orphan every existing config next run (ConfigManager
-- would start looking in a brand-new, empty folder). To stay both
-- human-readable AND stable across renames, we keep a small index file
-- mapping PlaceId -> "the folder name we used last time" under Bishop/, and
-- if the name has changed since last run we migrate the old folder's files
-- into the new name instead of abandoning them.
local GAME_INDEX_PATH = BISHOP_DIRECTORY .. "/_GameFolderIndex.json"

local function loadGameIndex()
    if not isfile(GAME_INDEX_PATH) then return {} end
    local ok, decoded = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(GAME_INDEX_PATH))
    end)
    return (ok and type(decoded) == "table") and decoded or {}
end

local function saveGameIndex(index)
    pcall(function()
        writefile(GAME_INDEX_PATH, game:GetService("HttpService"):JSONEncode(index))
    end)
end

local function migrateFolder(oldPath, newPath)
    pcall(function()
        if not isfolder(newPath) then makefolder(newPath) end
        for _, filePath in ipairs(listfiles(oldPath)) do
            local fileName = filePath:match("[^/\\]+$")
            if fileName then
                writefile(newPath .. "/" .. fileName, readfile(filePath))
            end
        end
        delfolder(oldPath)
    end)
end

local function getGameFolderName()
    local placeKey = tostring(game.PlaceId)
    local fallback = "Game_" .. placeKey

    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    local rawName = ok and info and info.Name
    local currentName = (type(rawName) == "string" and rawName ~= "")
        and sanitizeFolderName(rawName) or nil
    currentName = currentName or fallback

    if not isfolder(BISHOP_DIRECTORY) then makefolder(BISHOP_DIRECTORY) end

    local index = loadGameIndex()
    local previousName = index[placeKey]

    if previousName and previousName ~= currentName then
        local oldPath = BISHOP_DIRECTORY .. "/" .. previousName
        local newPath = BISHOP_DIRECTORY .. "/" .. currentName
        if isfolder(oldPath) and not isfolder(newPath) then
            migrateFolder(oldPath, newPath)
        end
    end

    index[placeKey] = currentName
    saveGameIndex(index)

    return currentName
end

-- Config Manager --
local GameFolderName = getGameFolderName()

local configOk, ConfigManager = pcall(function()
    return Compkiller:ConfigManager({
        Directory = BISHOP_DIRECTORY,
        Config = GameFolderName, -- e.g. "Bishop/Baseplate/", stable across game renames
