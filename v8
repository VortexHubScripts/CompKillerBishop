local LOCAL_UI_PATH = nil -- e.g. "ComkillerUI.lua"

-- Fetch and compile are split out (instead of the usual one-liner) purely so a
-- failure here tells you WHICH step broke — an empty/short HttpGet response
-- means the fetch itself failed (blocked domain, rate limit, bad connection);
-- a loadstring error message means the source compiled with a real syntax
-- error. Collapsing both into `loadstring(game:HttpGet(url))()` just gives
-- "attempt to call a nil value" either way, which doesn't tell you anything.
local rawSource
local usedLocalFile = LOCAL_UI_PATH and isfile and isfile(LOCAL_UI_PATH)

if usedLocalFile then
    rawSource = readfile(LOCAL_UI_PATH)
else
    rawSource = game:HttpGet(UI_SOURCE_URL)
end

