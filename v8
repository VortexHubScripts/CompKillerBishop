end)

if not configOk then
    -- Last-resort fallback so anything unexpected can never hard-crash the script.
    ConfigManager = Compkiller:ConfigManager({
        Directory = BISHOP_DIRECTORY,
        Config = "Game_" .. tostring(game.PlaceId),
    })
end

